# Root-level settings. These configure the LOCAL docker-compose stack and the
# deployment scripts under infra/scripts/ - they are not application settings.
#
# The app's own configuration lives in Python/.env.example and React/.env.example.
# Copy this to `.env`; it is git-ignored.

# --- local stack (docker-compose.yml) ---------------------------------------
# All optional. Left blank, the API runs on its built-in offline AI providers.
# With a key set, choose which engine runs from the admin panel (Settings).
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
TEXTRACT_ENABLED="false"

# --- deployment (infra/scripts/deploy.sh) -----------------------------------
# Prefix for every AWS resource name and for the CloudFormation export
# namespace. Change it to run a second, fully isolated environment in the same
# account - e.g. PROJECT_NAME=skill-upgradation-staging.
PROJECT_NAME="skill-upgradation"
AWS_REGION="us-east-1"

# --- pipeline source (infra/cloudformation/40-pipeline.yaml) ----------------
# Required by `deploy.sh pipeline`.
GITHUB_OWNER=""
GITHUB_REPO=""
GITHUB_BRANCH="main"

# Reuse an existing CodeConnections connection. Leave blank and the stack
# creates one - but it lands in PENDING state and you must finish the GitHub
# OAuth handshake in the console before the pipeline can run.
CODESTAR_CONNECTION_ARN=""

# Optional: email address subscribed to pipeline failure alerts.
NOTIFICATION_EMAIL=""
