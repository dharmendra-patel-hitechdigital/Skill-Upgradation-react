# Keep the build context small and, more importantly, keep secrets and local
# state out of the image.
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/

.env
*.db
*.sqlite3
var/
# tests/ is deliberately NOT excluded: the Dockerfile's `test` stage
# copies it, so the suite runs inside the same image the API ships as.
# The runtime stage never COPYs it, so the shipped image stays clean.
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage*

.git/
.gitignore
.github/
*.md
!README.md
.vscode/
.idea/
Dockerfile
docker-compose.yml
.dockerignore
