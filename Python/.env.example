# ==========================================================================
# Copy to `.env` and adjust. `.env` is git-ignored - never commit real secrets.
#
# Everything here has a working default EXCEPT SECRET_KEY in production.
# The service runs, and the AI document feature works end to end, with this
# file left exactly as-is (using the built-in offline providers).
# ==========================================================================

# --- project ---------------------------------------------------------------
PROJECT_NAME="Intelligent Document Service"
# local | development | staging | production | test
ENVIRONMENT="local"
API_V1_PREFIX="/api/v1"
DEBUG=false

# --- database --------------------------------------------------------------
# Write the familiar blocking URL; the app derives the async driver for itself
# and the sync driver for Alembic, so this one value serves both.
#
# SQLite (zero setup, default). Fine for development and the test suite, but it
# serialises writers - use MySQL or Postgres for anything concurrent.
DATABASE_URL="sqlite:///./app.db"
#
# MySQL (matches db/schema_mysql.sql):
# DATABASE_URL="mysql+pymysql://appuser:your_password@localhost:3306/appdb"
#
# PostgreSQL (also supported; install `asyncpg` and `psycopg2-binary`):
# DATABASE_URL="postgresql://appuser:your_password@localhost:5432/appdb"

DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
# Leave unset to auto-create tables everywhere except production. Set false to
# rely solely on `alembic upgrade head`.
# AUTO_CREATE_TABLES=false

# --- security --------------------------------------------------------------
# REQUIRED in production - the app refuses to start with the placeholder.
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY="CHANGE_ME_use_a_long_random_value"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ISSUER="intelligent-document-service"
JWT_AUDIENCE="intelligent-document-service.api"
PASSWORD_MIN_LENGTH=10

# Optional: create this admin on first startup, only while the user table is
# empty. Leave blank to instead let the first registered account become admin.
FIRST_ADMIN_EMAIL=""
FIRST_ADMIN_PASSWORD=""

# --- CORS ------------------------------------------------------------------
# Comma-separated or a JSON array. "*" is rejected in production.
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# --- uploads ---------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=20
ALLOWED_UPLOAD_TYPES="application/pdf,image/png,image/jpeg,image/tiff,text/plain"

# --- storage ---------------------------------------------------------------
# local | s3.  Use s3 as soon as you run more than one replica: a file uploaded
# to one instance must be readable by the background worker on another.
STORAGE_BACKEND="local"
STORAGE_LOCAL_DIR="./var/documents"
# S3_BUCKET="my-documents-bucket"
# S3_PREFIX="documents"

# --- AWS -------------------------------------------------------------------
# Leave the keys blank to use the default credential chain (IAM role, shared
# config, EC2/ECS/EKS metadata) - which is what you want in production.
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# --- AI: stage 1, text extraction -----------------------------------------
# auto     -> local reader for PDFs/text, Textract for images (when enabled)
# local    -> PDF text layer + plain text only (no OCR, no credentials)
# textract -> always AWS Textract
# none     -> disable extraction entirely
OCR_PROVIDER="auto"
# Turn on to process scanned images and photographed documents.
TEXTRACT_ENABLED=false

# --- AI: stage 2, analysis -------------------------------------------------
# auto      -> OpenAI when a key is set, otherwise the built-in rule engine
# openai    -> require OpenAI
# heuristic -> always use the offline rule engine
# none      -> disable analysis entirely
LLM_PROVIDER="auto"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
# OPENAI_BASE_URL="https://api.openai.com/v1"   # or an Azure/proxy endpoint
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_RETRIES=2
# Set to blank to omit `temperature` entirely - reasoning models reject any
# value other than their default.
OPENAI_TEMPERATURE=0.0
# Caps prompt size so one huge scan cannot blow up the context window or the bill.
LLM_MAX_INPUT_CHARS=24000

# --- background processing -------------------------------------------------
PROCESSING_MAX_CONCURRENCY=4
PROCESSING_TIMEOUT_SECONDS=180

# --- observability ---------------------------------------------------------
LOG_LEVEL="INFO"
# true emits one JSON object per line - what CloudWatch/Loki/Datadog want.
LOG_JSON=false
