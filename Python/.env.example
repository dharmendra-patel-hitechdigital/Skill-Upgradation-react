# ==========================================================================
# Copy to `.env` and adjust. `.env` is git-ignored - never commit real secrets.
#
# Everything here has a working default EXCEPT SECRET_KEY in production.
# The service runs, and the AI document feature works end to end, with this
# file left exactly as-is (using the built-in offline providers).
# ==========================================================================

# --- project ---------------------------------------------------------------
PROJECT_NAME="Intelligent Document Service"
# local | development | staging | production | test
ENVIRONMENT="local"
API_V1_PREFIX="/api/v1"
DEBUG=false

# --- database --------------------------------------------------------------
# Write the familiar blocking URL; the app derives the async driver for itself
# and the sync driver for Alembic, so this one value serves both.
#
# SQLite (zero setup, default). Fine for development and the test suite, but it
# serialises writers - use MySQL or Postgres for anything concurrent.
DATABASE_URL="sqlite:///./app.db"
#
# MySQL (matches db/schema_mysql.sql):
# DATABASE_URL="mysql+pymysql://appuser:your_password@localhost:3306/appdb"
#
# AWS RDS MySQL:
# DATABASE_URL="mysql+pymysql://admin:your_password@your-db.abc123.eu-north-1.rds.amazonaws.com:3306/appdb"
#
# PostgreSQL (also supported; install `asyncpg` and `psycopg2-binary`):
# DATABASE_URL="postgresql://appuser:your_password@localhost:5432/appdb"
#
# !! PASSWORDS WITH SPECIAL CHARACTERS MUST BE PERCENT-ENCODED !!
# The password is part of a URL, so reserved characters have to be escaped or the
# URL is parsed wrongly - usually silently, which makes it painful to debug.
#   #  ->  %23     (also starts a comment in this file, truncating the value)
#   $  ->  %24         /  ->  %2F         :  ->  %3A
#   @  ->  %40         ?  ->  %3F         %  ->  %25
# So a password like  Secr#t$99  is written  Secr%23t%2499
# Generate the encoded form safely (nothing is echoed to your shell history):
#   python -c "from urllib.parse import quote_plus; print(quote_plus(input()))"

# --- database, supplied as discrete parts (deployed environments) -----------
# Set DB_HOST and the app assembles DATABASE_URL from these, overriding the
# value above. This is how the ECS task definition wires up RDS: the password
# arrives on its own, injected straight from a Secrets Manager JSON key, and a
# task definition cannot splice a secret into the middle of a URL.
#
# Assembling in code also percent-encodes the credentials, so a generated
# password containing # $ / @ % just works - no manual escaping.
# DB_HOST="your-db.abc123.eu-north-1.rds.amazonaws.com"
# DB_PORT=3306
# DB_NAME="appdb"
# DB_USER="admin"
# DB_PASSWORD=""
# DB_DIALECT="mysql"

DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
# Seconds allowed for a new connection + handshake. The async MySQL driver's own
# default is too aggressive for a managed database reached over the internet
# (e.g. RDS in another region), where a slow TLS handshake surfaces as a bare
# "Can't connect to MySQL server" that looks like a firewall problem.
DB_CONNECT_TIMEOUT_SECONDS=30
# Keep this BELOW the server's wait_timeout so the pool never hands out a socket
# the server has already closed. RDS defaults to 28800s; 280s is safe anywhere.
DB_POOL_RECYCLE_SECONDS=1800
# Leave unset to auto-create tables everywhere except production. Set false to
# rely solely on `alembic upgrade head`.
# AUTO_CREATE_TABLES=false

# --- security --------------------------------------------------------------
# REQUIRED in production - the app refuses to start with the placeholder.
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY="CHANGE_ME_use_a_long_random_value"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ISSUER="intelligent-document-service"
JWT_AUDIENCE="intelligent-document-service.api"
PASSWORD_MIN_LENGTH=10

# Optional: create this admin on first startup, only while the user table is
# empty. Leave blank to instead let the first registered account become admin.
FIRST_ADMIN_EMAIL=""
FIRST_ADMIN_PASSWORD=""

# --- CORS ------------------------------------------------------------------
# Comma-separated or a JSON array. "*" is rejected in production.
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# --- uploads ---------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=20
ALLOWED_UPLOAD_TYPES="application/pdf,image/png,image/jpeg,image/tiff,text/plain"

# --- storage ---------------------------------------------------------------
# local | s3.  Use s3 as soon as you run more than one replica: a file uploaded
# to one instance must be readable by the background worker on another.
STORAGE_BACKEND="local"
STORAGE_LOCAL_DIR="./var/documents"
# S3_BUCKET="my-documents-bucket"
# S3_PREFIX="documents"

# --- AWS -------------------------------------------------------------------
# Leave the keys blank to use the default credential chain (IAM role, shared
# config, EC2/ECS/EKS metadata) - which is what you want in production.
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# --- AI: stage 1, text extraction -----------------------------------------
# auto     -> local reader for PDFs/text, Textract for images (when enabled)
# local    -> PDF text layer + plain text only (no OCR, no credentials)
# textract -> always AWS Textract
# none     -> disable extraction entirely
OCR_PROVIDER="auto"
# Turn on to process scanned images and photographed documents.
TEXTRACT_ENABLED=false

# --- AI: stage 2, analysis -------------------------------------------------
# The DEFAULT engine. An administrator can override it at runtime from the admin
# panel (Settings -> Document analysis engine); that choice is stored in the
# database and applies to the next document processed, on every replica.
#
# auto      -> the best configured engine: Claude, then OpenAI, then the rule engine
# claude    -> require Anthropic Claude
# openai    -> require OpenAI
# heuristic -> always use the offline rule engine
# none      -> disable analysis entirely
LLM_PROVIDER="auto"

# Keys are deployment secrets and are NOT settable from the admin panel - only
# the choice of which configured engine to use is. In a deployed environment
# these come from AWS Secrets Manager rather than this file.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5"
# ANTHROPIC_BASE_URL="https://api.anthropic.com"   # or a gateway/proxy endpoint
ANTHROPIC_TIMEOUT_SECONDS=120
ANTHROPIC_MAX_RETRIES=2
# How hard the model thinks per document: low | medium | high | xhigh | max.
# Extraction is largely mechanical, so "medium" trades a little quality for real
# latency on a queue. Raise it for dense contracts and poor scans.
ANTHROPIC_EFFORT="medium"
# Output ceiling. The analysis schema caps out well below this, so a response
# that hits it is truncated JSON and is reported as such.
ANTHROPIC_MAX_OUTPUT_TOKENS=8192

OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
# OPENAI_BASE_URL="https://api.openai.com/v1"   # or an Azure/proxy endpoint
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_RETRIES=2
# Set to blank to omit `temperature` entirely - reasoning models reject any
# value other than their default.
OPENAI_TEMPERATURE=0.0
# Caps prompt size so one huge scan cannot blow up the context window or the bill.
LLM_MAX_INPUT_CHARS=24000

# --- background processing -------------------------------------------------
PROCESSING_MAX_CONCURRENCY=4
PROCESSING_TIMEOUT_SECONDS=180

# --- observability ---------------------------------------------------------
LOG_LEVEL="INFO"
# true emits one JSON object per line - what CloudWatch/Loki/Datadog want.
LOG_JSON=false
